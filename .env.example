# Use an immutable image tag so deployments can be reproduced and rolled back.
PLAINMOTE_IMAGE=ghcr.io/OWNER/plainmote:VERSION

# Keep this on loopback when the reverse proxy or Cloudflare Tunnel runs on
# the same host.
PLAINMOTE_BIND=127.0.0.1
PLAINMOTE_PORT=8964

# PostgreSQL and S3-compatible object storage.
DATABASE_URL=
PLAINMOTE_BLOB_ENDPOINT=
PLAINMOTE_BLOB_BUCKET=
PLAINMOTE_BLOB_REGION=auto
PLAINMOTE_BLOB_ACCESS_KEY=
PLAINMOTE_BLOB_SECRET_KEY=

# Public HTTPS origin, without a trailing slash or path.
PLAINMOTE_PUBLIC_URL=

# Generate once with: openssl rand -hex 32
# Back it up. Replacing it makes existing share tokens impossible to decrypt.
PLAINMOTE_TOKEN_KEY=

# GitHub OAuth App credentials. For https://plainmote.example.com, use this
# callback URL: https://plainmote.example.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# open accepts any new GitHub user; allowlist accepts only these numeric IDs;
# closed accepts no new users. Existing users can still sign in.
PLAINMOTE_REGISTRATION_MODE=allowlist
GITHUB_ALLOWED_IDS=

# Optional application settings.
PLAINMOTE_ANONYMOUS=false
PLAINMOTE_TRUSTED_PROXIES=
PLAINMOTE_SESSION_TTL=720h
PLAINMOTE_MAX_CONTENT_MIB=10
PLAINMOTE_LOG_RETENTION=720h

# Setting a contact address publishes /about, /privacy, /terms and /contact.
PLAINMOTE_OPERATOR=
PLAINMOTE_CONTACT_EMAIL=
# Where the "Source code" link on every page points. Leave empty for the
# upstream repository; a deployment of modified code must link to its own
# source (AGPL-3.0).
PLAINMOTE_SOURCE_URL=

# The admin interface (docs/admin-api.md). Absent unless a key is set: Ed25519
# public keys from `go run ./cmd/plainmote-admin keygen`, comma-separated. The
# private key never goes here. Origins are the admin pages allowed to call it
# from a browser, e.g. http://localhost:5173.
PLAINMOTE_ADMIN_KEYS=
PLAINMOTE_ADMIN_ORIGINS=
